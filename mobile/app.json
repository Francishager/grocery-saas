{
  "expo": {
    "name": "JibuSales",
    "slug": "jibusales",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jibusales",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.jibusales.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "JibuSales uses the camera when you choose to capture an image for a business record.",
        "NSPhotoLibraryUsageDescription": "JibuSales uses selected photos when you attach an image to a business record.",
        "NSLocationWhenInUseUsageDescription": "JibuSales uses your location for attendance check-in and check-out when your business enables it.",
        "NSBluetoothAlwaysUsageDescription": "JibuSales connects to a Bluetooth receipt printer when you choose to print."
      }
    },
    "android": {
      "package": "com.jibusales.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#16764A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16764A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 168
        }
      ],
      "expo-secure-store"
    ],
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f77d8c1c-aca0-42de-8d30-50b97604b99a"
      }
    },
    "owner": "jibusaless-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f77d8c1c-aca0-42de-8d30-50b97604b99a"
    }
  }
}
