# Set FRONTEND_ORIGIN to the deployed JibuSales frontend origin for checkout returns.

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration
# SMTP2GO HTTPS API works on Railway Hobby. Verify the sender email in SMTP2GO first.
EMAIL_PROVIDER="smtp2go"
SMTP2GO_API_KEY="api-your_smtp2go_api_key"
SMTP2GO_FROM="jibusales00@gmail.com"
# Optional: defaults to the EU API endpoint.
# SMTP2GO_API_URL="https://eu-api.smtp2go.com/v3/email/send"

# Resend HTTPS API alternative.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM="JibuSales <notifications@your-verified-domain.com>"

# GMass SMTP (EMAIL_PROVIDER=smtp). Railway outbound SMTP requires the Pro plan.
GMASS_SMTP_HOST="smtp.gmass.co"
GMASS_SMTP_PORT="587"
GMASS_SMTP_USER="gmass"
GMASS_SMTP_PASS="your_rotated_gmass_smtp_password"
EMAIL_FROM="jibusales00@gmail.com"

# Feature Flags
ENABLE_SEED=false
OBFUSCATE_ADMIN=false

# Exchange rates (the key stays on the backend; never add it to frontend VITE_* variables)
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key
