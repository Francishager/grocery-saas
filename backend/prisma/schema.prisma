  @@map("tax_payments")
}

// =====================================================
// USER GUIDE STEPS — SaaS admin manages step-by-step guides with images
// =====================================================

model UserGuideStep {
  id            String   @id @default(cuid())
  category      String // e.g. "sales", "inventory", "branches", "staff"
  stepNumber    Int // order within category
  title         String
  description   String
  imageUrl      String? // Uploaded image URL
  imagePublicId String? // Uploaded image identifier for deletion
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category, stepNumber])
  @@map("user_guide_steps")
}

// =====================================================
// PUSH NOTIFICATION TOKENS (FCM)
// =====================================================

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform  String   @default("web") // web, android, ios
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@map("push_tokens")
}

// =====================================================
// WIDGET DATA — Sticky Notes & Calculator History
// =====================================================

model StickyNote {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title  String  @default("")
  lines  Json    @default("[]") // [{ id, type: text|task|numbered, text, done, number }]
  color  String  @default("yellow")
  pinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@map("sticky_notes")
}

model CalculatorHistory {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  history Json @default("[]") // [{ expression, result, timestamp }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@map("calculator_history")
}

// Credit Notes — issued to customers to reduce receivables (returns, allowances, overcharges)
model CreditNote {
  id         String   @id @default(cuid())
  noteNo     String
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  saleId     String? // Linked sale record (optional)
  amount     Float
  reason     String // sales_return, price_adjustment, overcharge, cancellation, other
  status     String   @default("issued") // issued, applied, cancelled
  notes      String?
  userId     String // Who issued it
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, noteNo])
  @@index([tenantId, branchId])
  @@index([customerId])
  @@map("credit_notes")
}

// Debit Notes — issued to suppliers to reduce payables (returns, short delivery, quality issues, price adjustments)
model DebitNote {
  id         String   @id @default(cuid())
  noteNo     String
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  purchaseId String? // Linked purchase (optional)
  amount     Float
  reason     String // purchase_return, short_delivery, quality_issue, price_adjustment, other
  status     String   @default("issued") // issued, applied, cancelled
  notes      String?
  userId     String // Who issued it
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, noteNo])
  @@index([tenantId, branchId])
  @@index([supplierId])
  @@map("debit_notes")
}

// =====================================================
// PHASE 1: HR CORE MODULE - NEW MODELS
// =====================================================

// =====================================================
// ORGANIZATION STRUCTURE
// =====================================================

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation("TenantDepartments", fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  code        String // e.g., "SALES", "HR", "IT"
  description String?
  headId      String? // Department head/manager (Employee ID)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[] @relation("DepartmentEmployees")
  units     Unit[]
  teams     Team[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("departments")
}

model Unit {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation("TenantUnits", fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  code         String // e.g., "SALES-FIELD"
  description  String?
  headId       String? // Unit head (Employee ID)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employees Employee[] @relation("UnitEmployees")
  teams     Team[]

  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
  @@map("units")
}

model Team {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation("TenantTeams", fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  name         String
  code         String // e.g., "SALES-FIELD-A"
  description  String?
  leaderId     String? // Team lead (Employee ID)
  size         Int        @default(0) // Team size
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employees Employee[] @relation("TeamEmployees")

  @@unique([tenantId, code])
  @@index([tenantId, departmentId, unitId])
  @@map("teams")
}

model Position {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation("TenantPositions", fields: [tenantId], references: [id], onDelete: Cascade)
  name        String // e.g., "Sales Manager", "Accountant"
  code        String // e.g., "SAL-MGR"
  description String?
  level       String? // e.g., "Management", "Supervisory", "Staff"
  department  String? // Primary department
  minSalary   Float    @default(0)
  maxSalary   Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[] @relation("EmployeePositions")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("positions")
}

// =====================================================
// CONTRACTS
// =====================================================

model EmployeeContract {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation("TenantContracts", fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee  @relation("EmployeeContracts", fields: [employeeId], references: [id], onDelete: Cascade)
  contractNo         String    @unique // e.g., "CONTRACT-2025-001"
  contractType       String // employment, service, consulting, other
  status             String    @default("active") // draft, active, expiring, expired, renewed, terminated
  startDate          DateTime
  endDate            DateTime?
  renewalStatus      String? // up_for_renewal, renewed, not_renewed
  position           String?
  department         String?
  salary             Float? // Base salary per contract
  benefits           Json? // Benefits configuration
  probationPeriod    Int? // in days
  probationStartDate DateTime?
  probationEndDate   DateTime?
  terms              String? // Full text of terms
  notes              String?
  approvedBy         String?
  approvedAt         DateTime?
  documentUrl        String? // URL to contract document
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([tenantId, contractNo])
  @@index([tenantId, employeeId])
  @@index([status])
  @@map("employee_contracts")
}

// =====================================================
// EMPLOYEE DOCUMENTS
// =====================================================

model EmployeeDocument {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation("TenantEmployeeDocuments", fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee  @relation("EmployeeDocuments", fields: [employeeId], references: [id], onDelete: Cascade)
  documentType    String // employment_contract, national_id, passport, academic_certificate, professional_certificate, cv, appointment_letter, promotion_letter, warning_letter, training_certificate, medical_document, other
  fileName        String
  fileUrl         String // Uploaded document URL
  issueDate       DateTime?
  expiryDate      DateTime? // For certificates, IDs, etc
  expiryAlertDays Int? // Alert X days before expiry
  uploadedBy      String
  uploadedAt      DateTime  @default(now())
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, employeeId])
  @@index([documentType])
  @@index([expiryDate])
  @@map("employee_documents")
}

// =====================================================
// SALARY HISTORY (Never overwrite, always track changes)
// =====================================================

model SalaryHistory {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation("TenantSalaryHistory", fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee  @relation("EmployeeSalaryHistory", fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary        Float
  transportAllowance Float     @default(0)
  houseAllowance     Float     @default(0)
  mobileAllowance    Float     @default(0)
  otherAllowances    Float     @default(0)
  totalAllowances    Float     @default(0)
  grossSalary        Float
  paye               Float     @default(0)
  socialSecurityTax  Float     @default(0)
  healthInsurance    Float     @default(0)
  otherDeductions    Float     @default(0)
  totalDeductions    Float     @default(0)
  effectiveDate      DateTime // When this salary became effective
  reason             String // new_employment, salary_review, promotion, adjustment, demotion, contract_renewal, other
  approvedBy         String?
  approvedAt         DateTime?
  notes              String?
  createdAt          DateTime  @default(now())

  @@unique([employeeId, effectiveDate]) // One salary per employee per effective date
  @@index([tenantId, employeeId])
  @@index([effectiveDate])
  @@map("salary_histories")
}

// =====================================================
// EMPLOYMENT HISTORY (Track status and role changes)
// =====================================================

model EmploymentHistory {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation("TenantEmploymentHistory", fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee  @relation("EmployeeEmploymentHistory", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentStatus String // active, on_probation, on_leave, suspended, notice_period, resigned, terminated, etc
  position         String?
  department       String?
  branch           String?
  salary           Float?
  reason           String? // promotion, transfer, demotion, status_change, etc
  effectiveDate    DateTime
  endDate          DateTime? // When this assignment ended
  notes            String?
  recordedBy       String
  recordedAt       DateTime  @default(now())

  @@index([tenantId, employeeId])
  @@index([effectiveDate])
  @@map("employment_histories")
}

// =====================================================
// HR MODULE FEATURES (SaaS Feature Control)
// =====================================================

model HRModuleFeature {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation("TenantHRFeatures", fields: [tenantId], references: [id], onDelete: Cascade)
  featureName String // attendance_tracking, shift_management, leave_management, payroll_processing, etc
  isEnabled   Boolean  @default(false)
  config      Json? // Feature-specific configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, featureName])
  @@index([tenantId])
  @@map("hr_module_features")
}

// =====================================================
// PHASE 2: LEAVE TYPE CONFIGURATION
// =====================================================

model LeaveType {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String // "Annual Leave", "Sick Leave"
  code                String // "AL", "SL"
  description         String?
  daysAllowedPerYear  Int
  carryoverAllowed    Boolean  @default(false)
  maxCarryover        Int? // Max carryover days
  requiresMedical     Boolean  @default(false)
  requiresApproval    Boolean  @default(true)
  approvalLevels      Int      @default(1) // 1 or 2 level
  color               String? // For calendar
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

model LeaveBalance {
  id                   String   @id @default(cuid())
  tenantId             String
  employeeId           String
  leaveTypeId          String
  leaveTypeName        String // Denormalized
  year                 Int // 2024, 2025
  allocatedDays        Float
  usedDays             Float    @default(0)
  approvedPendingDays  Float    @default(0)
  pendingApprovalDays  Float    @default(0)
  carryoverDays        Float    @default(0)
  remainingDays        Float // Calculated
  lastUpdatedAt        DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId, employeeId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveHistory {
  id                 String   @id @default(cuid())
  tenantId           String
  employeeId         String
  leaveTypeId        String
  leaveTypeName      String
  leaveRequestId     String? // Link to request
  startDate          DateTime
  endDate            DateTime
  totalDays          Float
  reason             String?
  manualEntry        Boolean  @default(false)
  createdBy          String // UserId
  createdAt          DateTime @default(now())

  @@index([tenantId, employeeId])
  @@index([startDate, endDate])
  @@map("leave_histories")
}

// =====================================================
// PHASE 2: ATTENDANCE TRACKING
// =====================================================

model AttendanceConfiguration {
  id                   String   @id @default(cuid())
  tenantId             String
  branchId             String?
  workingHoursPerDay   Float    @default(8.0)
  workWeekDays         String[] @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"])
  overtimeStartHour    Float    @default(8.0)
  lateTolerance        Int      @default(0) // minutes
  earlyCheckoutAllowed Boolean  @default(true)
  geofencingEnabled    Boolean  @default(false)
  biometricRequired    Boolean  @default(false)
  qrCodeRequired       Boolean  @default(false)
  methods              String[] @default(["MANUAL"]) // MANUAL, QR_CODE, BIOMETRIC
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, branchId])
  @@index([tenantId])
  @@map("attendance_configurations")
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  attendanceDate DateTime
  checkInTime   DateTime?
  checkOutTime  DateTime?
  duration      Float? // hours worked
  lateMinutes   Int?
  overtimeMinutes Int?
  method        String   @default("MANUAL") // MANUAL, QR_CODE, BIOMETRIC
  location      String? // GPS location
  notes         String?
  status        String   @default("present") // present, absent, on_leave, half_day, leave
  approvedBy    String? // UserId
  approvedAt    DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, employeeId, attendanceDate])
  @@index([tenantId, employeeId])
  @@index([attendanceDate])
  @@map("attendance_records")
}

model AttendanceSummary {
  id              String   @id @default(cuid())
  tenantId        String
  employeeId      String
  periodStart     DateTime // Month start
  periodEnd       DateTime // Month end
  presentDays     Int      @default(0)
  absentDays      Int      @default(0)
  leaveDays       Int      @default(0)
  overtimeHours   Float    @default(0)
  averageCheckInTime  String? // HH:MM
  averageCheckOutTime String? // HH:MM
  workingDaysInPeriod Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, employeeId, periodStart])
  @@index([tenantId, employeeId])
  @@map("attendance_summaries")
}

model AttendanceAudit {
  id        String   @id @default(cuid())
  tenantId  String
  recordId  String
  changedBy String // UserId
  changeType String // created, edited, approved, deleted
  oldValues Json?
  newValues Json?
  reason    String?
  timestamp DateTime @default(now())

  @@index([tenantId, recordId])
  @@index([timestamp])
  @@map("attendance_audits")
}

// =====================================================
// PHASE 2: SHIFT MANAGEMENT
// =====================================================

model ShiftTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String?
  name            String // "Morning Shift", "Night Shift"
  code            String // "MS", "NS"
  description     String?
  startTime       String // "09:00"
  endTime         String // "17:00"
  breakDuration   Int      @default(60) // minutes
  workingHours    Float
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, branchId, code])
  @@index([tenantId])
  @@map("shift_templates")
}

model ShiftAssignment {
  id                  String   @id @default(cuid())
  tenantId            String
  employeeId          String
  shiftTemplateId     String
  shiftTemplateName   String // Denormalized
  assignmentStartDate DateTime // When assignment begins
  assignmentEndDate   DateTime? // When assignment ends (NULL = ongoing)
  rotationType        String   @default("FIXED") // FIXED, ROTATING, TEMPORARY
  reason              String?
  approvedBy          String?
  approvedAt          DateTime?
  status              String   @default("pending") // pending, active, ended, on_hold
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, employeeId, assignmentStartDate])
  @@index([tenantId, employeeId])
  @@index([assignmentStartDate])
  @@map("shift_assignments")
}

model ShiftSwap {
  id                String   @id @default(cuid())
  tenantId          String
  requesterId       String // Who wants to swap
  targetEmployeeId  String // Who they want to swap with
  originalShiftDate DateTime // Employee 1's original shift
  swapDate          DateTime // Employee 2's shift date (what Employee 1 wants)
  reason            String?
  requestedAt       DateTime @default(now())
  approverIds       String[] // Manager/HR who can approve
  approvedAt        DateTime?
  approvedBy        String?
  status            String   @default("pending") // pending, approved, rejected, executed, cancelled
  executedAt        DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, requesterId])
  @@index([status])
  @@map("shift_swaps")
}

