// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id       String  @id @default(cuid())
  name     String
  address  String?
  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  users                UserBranch[]
  products             Product[]
  accounts             Account[]
  sales                Sale[]
  purchases            Purchase[]
  customers            Customer[]
  saleRecords          SaleRecord[]
  customerPayments     CustomerPayment[]
  customerWithdrawals  CustomerWithdrawal[]
  invoices             Invoice[]
  suppliers            Supplier[]
  supplierPurchases    SupplierPurchase[]
  supplierPayments     SupplierPayment[]
  expenses             Expense[]
  rentals              Rental[]
  saleReturns          SaleReturn[]
  journalEntries       JournalEntry[]
  employees            Employee[]
  payrolls             Payroll[]
  stockTransfersFrom   StockTransfer[]       @relation("TransferFrom")
  stockTransfersTo     StockTransfer[]       @relation("TransferTo")
  restaurantTables     RestaurantTable[]
  restaurantOrders     RestaurantOrder[]
  reservations         Reservation[]
  fuelPumps            FuelPump[]
  fuelTanks            FuelTank[]
  fuelDeliveries       FuelDelivery[]
  fuelShiftReports     FuelShiftReport[]
  fuelDipstickReadings FuelDipstickReading[]
  fuelPricing          FuelPricing[]
  fuelCompliance       FuelCompliance[]
  productionOrders     ProductionOrder[]
  farmFields           FarmField[]
  livestock            Livestock[]
  harvests             Harvest[]
  farmExpenses         FarmExpense[]
  appointments         Appointment[]
  workOrders           WorkOrder[]
  serviceContracts     ServiceContract[]
  serviceJobCards      ServiceJobCard[]
  serviceFeedback      ServiceFeedback[]
  serviceTechnicians   ServiceTechnician[]
  assets               Asset[]
  fuelCards            FuelCard[]
  fuelCardTransactions FuelCardTransaction[]
  taxPayments          TaxPayment[]
  creditNotes          CreditNote[]
  debitNotes           DebitNote[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Department Department[]

  @@unique([tenantId, name])
  @@map("branches")
}

model UserBranch {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@map("user_branches")
}

// Tenant/Business - each business is a tenant in the SaaS
model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  email        String       @unique
  phone        String?
  address      String?
  logo         String?
  status       TenantStatus @default(active)
  businessType String? // retail, pharmacy, hardware, supermarket, wholesale, restaurant, bar, restaurant_bar, cafe, coffee_shop, fast_food, hotel_restaurant, bakery, service, salon_spa, repair_shop, manufacturing, other

  // =====================
  // PLAN RELATION
  // =====================
  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  // =====================
  // SUBSCRIPTION PERIOD
  // =====================
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  trialEndsAt       DateTime?

  // =====================
  // OWNERSHIP (1-1)
  // =====================
  ownerId String? @unique
  owner   User?   @relation("TenantOwner", fields: [ownerId], references: [id])

  // =====================
  // USERS (1-MANY)
  // =====================
  users User[] @relation("TenantUsers")

  // =====================
  // BRANCHES
  // =====================
  branches Branch[]

  // =====================
  // INVITATIONS
  // =====================
  invitations Invitation[]

  // =====================
  // BUSINESS DATA
  // =====================
  customers               Customer[]
  customerWithdrawals     CustomerWithdrawal[]
  suppliers               Supplier[]
  features                TenantFeature[]
  cashAccounts            CashAccount[]
  expenses                Expense[]
  cashTransactions        CashTransaction[]
  rentals                 Rental[]
  saleReturns             SaleReturn[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  employees               Employee[]
  attendance              Attendance[]
  leaveRequests           LeaveRequest[]
  salaryAdvances          SalaryAdvance[]
  salaryAdvanceRecoveries SalaryAdvanceRecovery[]
  payrolls                Payroll[]
  payrollAdjustments      PayrollAdjustment[]
  payrollDeductions       PayrollDeduction[]
  payrollPayments         PayrollPayment[]
  employeeSalaryConfigs   EmployeeSalaryConfig[]
  hrAccountingConfig      HRAccountingConfig?
  hrAuditLogs             HRAuditLog[]

  // =====================
  // PHASE 1: HR CORE RELATIONS
  // =====================
  departments         Department[]        @relation("TenantDepartments")
  units               Unit[]              @relation("TenantUnits")
  teams               Team[]              @relation("TenantTeams")
  positions           Position[]          @relation("TenantPositions")
  employeeContracts   EmployeeContract[]  @relation("TenantContracts")
  employeeDocuments   EmployeeDocument[]  @relation("TenantEmployeeDocuments")
  salaryHistories     SalaryHistory[]     @relation("TenantSalaryHistory")
  employmentHistories EmploymentHistory[] @relation("TenantEmploymentHistory")
  hrModuleFeatures    HRModuleFeature[]   @relation("TenantHRFeatures")

  stockTransfers   StockTransfer[]
  notifications    Notification[]
  pushTokens       PushToken[]
  integrations     IntegrationConfig[]
  restaurantTables RestaurantTable[]
  restaurantOrders RestaurantOrder[]
  reservations     Reservation[]
  recipes          Recipe[]
  waiters          Waiter[]
  happyHourRules   HappyHourRule[]
  comboMeals       ComboMeal[]
  deliveries       Delivery[]

  // =====================
  // FUEL STATION
  // =====================
  fuelPumps            FuelPump[]
  fuelTanks            FuelTank[]
  fuelDeliveries       FuelDelivery[]
  fuelMeterReadings    FuelMeterReading[]
  fuelShiftReports     FuelShiftReport[]
  fuelDipstickReadings FuelDipstickReading[]
  fuelPricing          FuelPricing[]
  fuelCompliance       FuelCompliance[]

  // =====================
  // MANUFACTURING
  // =====================
  productionOrders  ProductionOrder[]
  productionWaste   ProductionWaste[]
  qualityChecks     QualityCheck[]
  productionBatches ProductionBatch[]

  // =====================
  // AGRICULTURE
  // =====================
  farmFields   FarmField[]
  livestock    Livestock[]
  harvests     Harvest[]
  farmExpenses FarmExpense[]

  // =====================
  // SERVICE ENGINE
  // =====================
  appointments       Appointment[]
  workOrders         WorkOrder[]
  serviceContracts   ServiceContract[]
  serviceJobCards    ServiceJobCard[]
  serviceFeedback    ServiceFeedback[]
  serviceTechnicians ServiceTechnician[]

  // =====================
  // ASSETS
  // =====================
  assets      Asset[]
  taxPayments TaxPayment[]

  // =====================
  // REFERRAL SYSTEM
  // =====================
  referralCode    ReferralCode?    @relation("ReferralCodeTenant")
  referralsMade   Referral[]       @relation("ReferrerTenant")
  referredBy      Referral?        @relation("ReferredTenant")
  referralRewards ReferralReward[] @relation("ReferralRewardTenant")

  // =====================
  // USAGE LIMIT
  // =====================
  usageLimitId String?
  usageLimit   UsageLimit? @relation(fields: [usageLimitId], references: [id])

  // =====================
  // BUSINESS SETTINGS
  // =====================
  currency      String  @default("UGX")
  timezone      String  @default("Africa/Kampala")
  dateFormat    String  @default("DD/MM/YY")
  taxRate       Float   @default(0) // e.g. 18 for 18% VAT
  taxEnabled    Boolean @default(false) // toggle tax on/off
  taxId         String? // VAT/GST registration number
  receiptHeader String? // Custom text at top of receipts
  receiptFooter String? // Custom text at bottom of receipts

  // =====================
  // BILLING OVERRIDES
  // =====================
  customPrice             Float? // Per-tenant override on the base plan fee
  customCurrency          String? // Per-tenant override currency, e.g. UGX / USD
  customBillingCycle      String? // monthly, yearly
  monthlyServiceFee       Float?    @default(0)
  annualServiceFee        Float?    @default(0)
  staticIpFee             Float?    @default(0)
  billingPaymentMethod    String? // cash, mobile_money, card, bank_transfer, relwork, kamatera
  billingPaymentReference String?
  billingNotes            String?
  gracePeriodDays         Int?      @default(0)
  reminderDaysBeforeDue   Int?      @default(10)
  paymentReminderSentAt   DateTime?
  paymentReminderStatus   String?   @default("not_started") // not_started, due_soon, grace_period, paid

  // =====================
  // MODULE DEFAULTS (based on businessType, overridable by feature control)
  // =====================
  inventoryEnabled Boolean @default(true) // On for product-based, off for service-based
  servicesEnabled  Boolean @default(true) // On for all business types

  // =====================
  // TIMESTAMPS
  // =====================
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // =====================
  // WIDGET DATA
  // =====================
  stickyNotes       StickyNote[]
  calculatorHistory CalculatorHistory[]
  creditNotes       CreditNote[]
  debitNotes        DebitNote[]

  @@map("tenants")
}

enum TenantStatus {
  active
  suspended
  cancelled
  trial
}

// Item Types - Product (consumable inventory), Service (no inventory), Rental (returnable inventory)
enum ItemType {
  product
  service
  rental
}

// Rental period for hire items
enum RentalPeriod {
  hourly
  daily
  weekly
  weekend
  monthly
  custom
}

// Rental record status
enum RentalStatus {
  active // Items are out on hire
  returned // Items have been returned
  overdue // Past expected return date
  lost // Item not returned, marked as lost
  cancelled // Booking cancelled before hire
}

// Condition of rental item
enum ItemCondition {
  good
  fair
  damaged
  broken
}

// Category Types - Product categories or Service categories
enum CategoryType {
  product
  service
  rental
}

// Subscription Plans
model Plan {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  price        Float
  currency     String        @default("USD")
  billingCycle String        @default("monthly") // monthly, yearly
  features     Json // Array of feature strings
  maxUsers     Int           @default(5)
  maxProducts  Int           @default(100)
  maxBranches  Int           @default(3)
  maxCustomers Int           @default(100)
  maxSuppliers Int           @default(50)
  isDefault    Boolean       @default(false)
  tenants      Tenant[]
  planFeatures PlanFeature[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("plans")
}

// Users - can be SaaS Admin or tenant users
model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  password           String
  fname              String?
  lname              String?
  phone              String?
  avatar             String?
  role               UserRole           @default(attendant)
  discountPermission DiscountPermission @default(none)

  // =========================
  // TENANT (many users per tenant)
  // =========================
  tenantId String?
  tenant   Tenant? @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Cascade)

  // =========================
  // TENANT OWNERSHIP (1 user owns 1 tenant)
  // =========================
  ownedTenant Tenant? @relation("TenantOwner")

  isActive               Boolean      @default(true)
  lastLogin              DateTime?
  otpCode                String?
  otpExpires             DateTime?
  hasCompletedOnboarding Boolean      @default(false) // Tenant onboarding guide completion status
  onboardingCompletedAt  DateTime? // When user completed the onboarding guide
  cashAccountId          String? // Assigned cash account for cash handling accountability
  cashAccount            CashAccount? @relation("UserCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // =========================
  // LEGACY RELATIONS
  // =========================
  sales       Sale[]
  purchases   Purchase[]
  invitations Invitation[] @relation("CreatedBy")

  // =========================
  // NEW RELATIONS
  // =========================
  saleRecords               SaleRecord[]
  customerWithdrawals       CustomerWithdrawal[]
  supplierPurchases         SupplierPurchase[]
  expenses                  Expense[]
  cashTransactions          CashTransaction[]
  rentals                   Rental[]
  saleReturns               SaleReturn[]
  journalEntries            JournalEntry[]
  stockTransfers            StockTransfer[]
  notifications             Notification[]
  pushTokens                PushToken[]
  restaurantOrders          RestaurantOrder[]
  tips                      Tip[]
  fuelShiftReports          FuelShiftReport[]
  productionOrders          ProductionOrder[]
  qualityChecks             QualityCheck[]
  serviceTechnicianProfiles ServiceTechnician[]
  appointmentTechnician     Appointment[]         @relation("AppointmentTechnician")
  workOrderTechnician       WorkOrder[]           @relation("WorkOrderTechnician")
  productPriceChanges       ProductPriceHistory[]

  // =========================
  // BRANCH ASSIGNMENTS
  // =========================
  branches          UserBranch[]
  permissions       UserPermission[]
  stickyNotes       StickyNote[]
  calculatorHistory CalculatorHistory[]

  @@map("users")
}

enum UserRole {
  saas_admin // Platform admin
  owner // Business owner
  manager // Business manager
  accountant // Business accountant
  attendant // Sales attendant
}

enum DiscountPermission {
  none // Cannot give discounts
  lineItem // Can give line item discounts
  invoice // Can give invoice-level discounts
  managerApproval // Requires manager approval for discounts
}

// Granular user permissions
model UserPermission {
  id                           String   @id @default(cuid())
  userId                       String
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Dashboard
  canViewDashboard             Boolean  @default(false)
  // Sales
  canCreateSale                Boolean  @default(false)
  canViewSale                  Boolean  @default(false)
  canEditSale                  Boolean  @default(false)
  canDeleteSale                Boolean  @default(false)
  canRefundSale                Boolean  @default(false)
  // Inventory
  canCreateProduct             Boolean  @default(false)
  canViewProduct               Boolean  @default(false)
  canViewPriceHistory          Boolean  @default(false)
  canEditProduct               Boolean  @default(false)
  canDeleteProduct             Boolean  @default(false)
  canAdjustStock               Boolean  @default(false)
  canTransferStock             Boolean  @default(false)
  // Purchases / Payables
  canCreatePurchase            Boolean  @default(false)
  canViewPurchase              Boolean  @default(false)
  canEditPurchase              Boolean  @default(false)
  canDeletePurchase            Boolean  @default(false)
  canCreatePayable             Boolean  @default(false)
  canViewPayable               Boolean  @default(false)
  canEditPayable               Boolean  @default(false)
  canDeletePayable             Boolean  @default(false)
  // Expenses
  canCreateExpense             Boolean  @default(false)
  canViewExpense               Boolean  @default(false)
  canEditExpense               Boolean  @default(false)
  canDeleteExpense             Boolean  @default(false)
  canViewStaffTillSheet        Boolean  @default(false)
  // Customers / Receivables
  canCreateCustomer            Boolean  @default(false)
  canViewCustomer              Boolean  @default(false)
  canEditCustomer              Boolean  @default(false)
  canDeleteCustomer            Boolean  @default(false)
  canCreateReceivable          Boolean  @default(false)
  canViewReceivable            Boolean  @default(false)
  canEditReceivable            Boolean  @default(false)
  canDeleteReceivable          Boolean  @default(false)
  // Suppliers
  canCreateSupplier            Boolean  @default(false)
  canViewSupplier              Boolean  @default(false)
  canEditSupplier              Boolean  @default(false)
  canDeleteSupplier            Boolean  @default(false)
  // Staff
  canCreateStaff               Boolean  @default(false)
  canViewStaff                 Boolean  @default(false)
  canEditStaff                 Boolean  @default(false)
  canDeleteStaff               Boolean  @default(false)
  // HR Management
  canViewHR                    Boolean  @default(false)
  canCreateHREmployee          Boolean  @default(false)
  canEditHREmployee            Boolean  @default(false)
  canDeleteHREmployee          Boolean  @default(false)
  canManageHRStructure         Boolean  @default(false)
  canViewHRContracts           Boolean  @default(false)
  canManageHRContracts         Boolean  @default(false)
  canViewHRDocuments           Boolean  @default(false)
  canManageHRDocuments         Boolean  @default(false)
  canViewHRSalaries            Boolean  @default(false)
  canManageHRSalaries          Boolean  @default(false)
  canViewHRAttendance          Boolean  @default(false)
  canRecordHRAttendance        Boolean  @default(false)
  canManageHRAttendance        Boolean  @default(false)
  canEditHRAttendance          Boolean  @default(false)
  canDeleteHRAttendance        Boolean  @default(false)
  canImportHRAttendance        Boolean  @default(false)
  canConfigureHRAttendance     Boolean  @default(false)
  canApproveHRAttendance       Boolean  @default(false)
  canViewHRShifts              Boolean  @default(false)
  canManageHRShifts            Boolean  @default(false)
  canAssignHRShifts            Boolean  @default(false)
  canApproveHRShifts           Boolean  @default(false)
  canViewHRLeave               Boolean  @default(false)
  canRequestHRLeave            Boolean  @default(false)
  canManageHRLeaveTypes        Boolean  @default(false)
  canApproveHRLeave            Boolean  @default(false)
  canViewHRPayroll             Boolean  @default(false)
  canCreateHRPayroll           Boolean  @default(false)
  canApproveHRPayroll          Boolean  @default(false)
  canPostHRPayroll             Boolean  @default(false)
  canPayHRPayroll              Boolean  @default(false)
  canManageHRPayrollSettings   Boolean  @default(false)
  canManageHRPayroll           Boolean  @default(false)
  // Branches
  canCreateBranch              Boolean  @default(false)
  canViewBranch                Boolean  @default(false)
  canEditBranch                Boolean  @default(false)
  canDeleteBranch              Boolean  @default(false)
  // Reports (granular)
  canViewSalesReport           Boolean  @default(false)
  canViewInventoryReport       Boolean  @default(false)
  canViewFinancialReport       Boolean  @default(false)
  canViewCustomerReport        Boolean  @default(false)
  canViewSupplierReport        Boolean  @default(false)
  canViewReceivablesReport     Boolean  @default(false)
  canViewPayablesReport        Boolean  @default(false)
  canViewPerformanceReport     Boolean  @default(false)
  canViewAuditReport           Boolean  @default(false)
