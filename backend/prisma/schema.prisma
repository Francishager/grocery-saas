// Invitations for new business owners
model Invitation {
  id          String           @id @default(cuid())
  email       String
  name        String?
  phone       String?
  token       String           @unique
  otpCode     String? // OTP for verification during acceptance
  status      InvitationStatus @default(pending)
  planId      String?
  message     String?
  tenantId    String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  createdById String
  createdBy   User             @relation("CreatedBy", fields: [createdById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("invitations")
}

enum InvitationStatus {
  pending
  accepted
  expired
  cancelled
}

// Products/Inventory
model Product {
  id               String        @id @default(cuid())
  name             String
  // =====================
  // ITEM TYPE (Product or Service)
  // =====================
  itemType         ItemType      @default(product)
  // Service-specific fields (null for products/rentals)
  serviceCategory  String? // e.g. "IT Services", "Legal Services", "Consulting"
  estimatedHours   Float? // Estimated duration for service delivery
  duration         String? // Human-readable duration: "2 hours", "1 week", etc.
  // =====================
  // RENTAL-SPECIFIC FIELDS (null for products/services)
  // =====================
  rentalPrice      Float? // Hire charge per period (e.g. per day)
  rentalPeriod     RentalPeriod? // Default billing period for this item
  depositAmount    Float? // Security deposit required
  replacementValue Float? // Cost if item is lost/damaged beyond repair
  // =====================
  // PRODUCT FIELDS (ignored for services, used for rental stock tracking)
  // =====================
  sku              String?
  barcode          String?
  batchNumber      String?
  description      String?
  price            Float
  cost             Float?
  quantity         Int           @default(0)
  minStock         Int           @default(10)
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  isUncategorized  Boolean       @default(false)
  tenantId         String
  branchId         String?
  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive         Boolean       @default(true)
  image            String?
  expiryDate       DateTime?
  baseUnit         String        @default("Piece") // Base unit of measure: KG, Bottle, Piece, Tablet, etc.
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Legacy relations (keep for compatibility)
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  // New relations
  saleRecordItems       SaleRecordItem[]
  supplierPurchaseItems SupplierPurchaseItem[]
  units                 ProductUnit[]
  rentalItems           RentalItem[]
  saleReturnItems       SaleReturnItem[]
  stockTransferItems    StockTransferItem[]
  recipeIngredients     RecipeIngredient[]
  comboMealItems        ComboMealItem[]
  orderItems            RestaurantOrderItem[]
  recipes               Recipe[]
  productionOrders      ProductionOrder[]
  productionWaste       ProductionWaste[]
  productionBatches     ProductionBatch[]
  harvests              Harvest[]
  appointmentProducts   Appointment[]
  workOrderProducts     WorkOrder[]
  priceHistory          ProductPriceHistory[]

  @@unique([tenantId, branchId, sku])
  @@unique([tenantId, branchId, barcode])
  @@index([tenantId, branchId])
  @@map("products")
}

model ProductPriceHistory {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenantId        String
  branchId        String?
  oldCost         Float?
  newCost         Float?
  oldPrice        Float?
  newPrice        Float?
  source          String   @default("manual_update")
  reference       String?
  reason          String?
  changedByUserId String?
  changedBy       User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([tenantId, branchId])
  @@index([productId, createdAt])
  @@map("product_price_history")
}

// Product Selling Units (Multi-UOM)
model ProductUnit {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName         String // e.g. "Quarter KG", "Pack", "Crate"
  conversionFactor Float // e.g. 0.25, 6, 24 — how many base units in this selling unit
  sellingPrice     Float // Price for this unit
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, unitName])
  @@map("product_units")
}

// Audit Log — tracks all data mutations
model AuditLog {
  id             String   @id @default(cuid())
  tenantId       String // tenant ID or "platform" for SaaS admin operations
  targetTenantId String? // which tenant was affected by this operation (for cross-tenant operations)
  userId         String
  userEmail      String
  action         String // create, update, delete, login, checkout, reset, suspend, enable, disable, etc.
  model          String // Product, Sale, Purchase, User, Plan, Tenant, Feature, etc.
  recordId       String? // ID of the affected record
  changes        Json? // { before: {...}, after: {...} } or { data: {...} }
  ip             String?
  statusCode     Int      @default(200) // HTTP status code
  severity       String   @default("info") // info, warning, critical
  createdAt      DateTime @default(now())

  @@index([tenantId, model])
  @@index([tenantId, createdAt])
  @@index([tenantId, severity])
  @@index([targetTenantId]) // fast lookup of operations affecting a specific tenant
  @@index([severity])
  @@map("audit_logs")
}

// Track tenant usage metrics (daily snapshots)
model TenantMetrics {
  id               String    @id @default(cuid())
  tenantId         String
  date             DateTime  @default(now())
  activeUsers      Int       @default(0)
  totalUsers       Int       @default(0)
  totalProducts    Int       @default(0)
  totalSales       Int       @default(0)
  totalSalesAmount Float     @default(0)
  featuresUsed     String[]  @default([]) // array of feature keys used
  lastActivityAt   DateTime?
  createdAt        DateTime  @default(now())

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([date])
  @@map("tenant_metrics")
}

// Track individual tenant operations/activity
model TenantActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  userEmail String
  action    String // login, create_product, create_sale, view_report, etc.
  model     String // Product, Sale, User, Report, etc.
  recordId  String?
  details   Json? // additional context specific to the activity
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, userId])
  @@map("tenant_activity_logs")
}

// Categories
model Category {
  id           String       @id @default(cuid())
  name         String
  slug         String
  tenantId     String
  categoryType CategoryType @default(product) // product or service
  products     Product[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@map("categories")
}

// Sales/Orders
model Sale {
  id             String       @id @default(cuid())
  receiptNo      String
  tenantId       String
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  total          Float
  subtotal       Float
  tax            Float        @default(0)
  discount       Float        @default(0)
  cashDiscount   Float        @default(0) // Invoice-level cash discount
  paymentMethod  String
  mobileProvider String?
  phoneNumber    String?
  transactionId  String?
  customerName   String?
  amountPaid     Float? // Amount customer paid (for cash change calculation)
  changeGiven    Float? // Change given back to customer
  status         SaleStatus   @default(completed)
  notes          String?
  items          SaleItem[]
  saleReturns    SaleReturn[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, receiptNo])
  @@index([tenantId, branchId])
  @@map("sales")
}

enum SaleStatus {
  pending
  completed
  cancelled
  refunded
}

// Sale Items
model SaleItem {
  id               String   @id @default(cuid())
  saleId           String
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int
  price            Float
  cost             Float?
  discount         Float    @default(0)
  cashDiscount     Float    @default(0) // Cash discount amount on this line item
  unitName         String? // Selling unit name (e.g. "Half KG", "Pack")
  conversionFactor Float? // Conversion factor used at time of sale
  total            Float
  createdAt        DateTime @default(now())

  @@map("sale_items")
}

// Purchases
model Purchase {
  id            String         @id @default(cuid())
  refNo         String?
  tenantId      String
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  supplier      String?
  paymentMethod String?        @default("cash")
  total         Float
  notes         String?
  items         PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, branchId])
  @@map("purchases")
}

// Purchase Items
model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  cost       Float
  total      Float
  createdAt  DateTime @default(now())

  @@map("purchase_items")
}

// =====================================================
// RECEIVABLES - Customer Credit System
// =====================================================

// Customers
model Customer {
  id                 String         @id @default(cuid())
  name               String
  email              String?
  phone              String?
  nin                String?
  address            String?
  tenantId           String
  branchId           String?
  branch             Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  creditLimit        Float          @default(0)
  balance            Float          @default(0) // Current outstanding balance
  openingBalance     Float          @default(0)
  openingBalanceDate DateTime?
  openingBalanceNote String?
  status             CustomerStatus @default(active)
  trustScore         Int            @default(0) // Calculated from repayment history
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sales            SaleRecord[]
  payments         CustomerPayment[]
  withdrawals      CustomerWithdrawal[]
  invoices         Invoice[]
  rentals          Rental[]
  saleReturns      SaleReturn[]
  reservations     Reservation[]
  deliveries       Delivery[]
  restaurantOrders RestaurantOrder[]
  appointments     Appointment[]
  workOrders       WorkOrder[]
  serviceContracts ServiceContract[]
  serviceFeedback  ServiceFeedback[]
  fuelCards        FuelCard[]
  Tenant           Tenant            @relation(fields: [tenantId], references: [id])

  creditNotes CreditNote[]

  @@unique([tenantId, branchId, phone])
  @@index([tenantId, branchId])
  @@map("customers")
}

enum CustomerStatus {
  active
  inactive
  blocked
}

// Sales Records (includes credit sales)
model SaleRecord {
  id            String            @id @default(cuid())
  receiptNo     String
  tenantId      String
  branchId      String?
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  userId        String
  total         Float
  subtotal      Float
  tax           Float             @default(0)
  discount      Float             @default(0)
  cashDiscount  Float             @default(0) // Invoice-level cash discount
  amountPaid    Float             @default(0)
  balance       Float             @default(0) // Remaining balance for credit sales
  paymentMethod String
  paymentStatus PaymentStatus     @default(paid)
  status        SaleRecordStatus  @default(completed)
  dueDate       DateTime?
  notes         String?
  items         SaleRecordItem[]
  payments      CustomerPayment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  User          User              @relation(fields: [userId], references: [id])

  @@unique([tenantId, receiptNo])
  @@index([tenantId, branchId])
  @@map("sale_records")
}

enum PaymentStatus {
  paid // Fully paid
  partial // Partially paid
  unpaid // Not paid at all (credit sale)
  overdue // Past due date
}

enum SaleRecordStatus {
  pending
  completed
  cancelled
  refunded
}

// Sale Record Items
model SaleRecordItem {
  id               String     @id @default(cuid())
  saleId           String
  sale             SaleRecord @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id])
  quantity         Int
  price            Float
  cost             Float?
  discount         Float      @default(0)
  cashDiscount     Float      @default(0) // Cash discount on this line item
  unitName         String? // Selling unit name
  conversionFactor Float? // Conversion factor used at time of sale
  total            Float
  createdAt        DateTime   @default(now())

  @@map("sale_record_items")
}

// Customer Payments
model CustomerPayment {
  id             String      @id @default(cuid())
  tenantId       String
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  saleId         String?
  sale           SaleRecord? @relation(fields: [saleId], references: [id])
  amount         Float
  paymentMethod  String // cash, mobile_money, bank_transfer
  mobileProvider String?
  phoneNumber    String?
  transactionId  String?
  reference      String? // Transaction reference
  notes          String?
  createdAt      DateTime    @default(now())

  @@index([tenantId, branchId])
  @@map("customer_payments")
}

// Customer Withdrawals
model CustomerWithdrawal {
  id             String       @id @default(cuid())
  tenantId       String
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  cashAccountId  String?
  cashAccount    CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  amount         Float
  paymentMethod  String       @default("cash")
  mobileProvider String?
  phoneNumber    String?
  transactionId  String?
  reference      String?
  notes          String?
  createdAt      DateTime     @default(now())
  Tenant         Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId, branchId])
  @@index([customerId])
  @@index([cashAccountId])
  @@map("customer_withdrawals")
}

// Invoices
model Invoice {
  id         String        @id @default(cuid())
  invoiceNo  String
  tenantId   String
  branchId   String?
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  saleId     String?
  total      Float
  amountPaid Float         @default(0)
  balance    Float
  status     InvoiceStatus @default(unpaid)
  dueDate    DateTime
  sentAt     DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, branchId])
  @@map("invoices")
}

enum InvoiceStatus {
  draft
  sent
  unpaid
  partial
  paid
  cancelled
  overdue
}

// Fuel Cards - Prepaid/credit cards issued by fuel station
model FuelCard {
  id          String         @id @default(cuid())
  cardNumber  String
  tenantId    String
  branchId    String?
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  holderName  String
  cardType    FuelCardType   @default(prepaid)
  balance     Float          @default(0)
  creditLimit Float          @default(0)
  status      FuelCardStatus @default(active)
  issuedAt    DateTime       @default(now())
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  transactions FuelCardTransaction[]

  @@unique([tenantId, cardNumber])
  @@index([tenantId, branchId])
  @@map("fuel_cards")
}

enum FuelCardType {
  prepaid
  credit
  fleet
}

enum FuelCardStatus {
  active
  suspended
  expired
  cancelled
}

model FuelCardTransaction {
  id           String   @id @default(cuid())
  cardId       String
  card         FuelCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tenantId     String
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type         String // reload, purchase, adjustment
  amount       Float
  balanceAfter Float
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([tenantId, branchId])
  @@map("fuel_card_transactions")
}

// =====================================================
// PAYABLES - Supplier Management
// =====================================================

// Suppliers
model Supplier {
  id                 String         @id @default(cuid())
  name               String
  email              String?
  phone              String?
  address            String?
  tenantId           String
  branchId           String?
  branch             Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  balance            Float          @default(0) // Amount owed to supplier
  openingBalance     Float          @default(0)
  openingBalanceDate DateTime?
  openingBalanceNote String?
  status             SupplierStatus @default(active)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  purchases SupplierPurchase[]
  payments  SupplierPayment[]
  Tenant    Tenant             @relation(fields: [tenantId], references: [id])

  debitNotes DebitNote[]

  @@unique([tenantId, branchId, phone])
  @@index([tenantId, branchId])
  @@map("suppliers")
}

enum SupplierStatus {
  active
  inactive
  blocked
}

// Supplier Purchases
model SupplierPurchase {
  id            String                 @id @default(cuid())
  refNo         String?
  tenantId      String
  branchId      String?
  branch        Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierId    String
  supplier      Supplier               @relation(fields: [supplierId], references: [id])
  userId        String
  total         Float
  amountPaid    Float                  @default(0)
  balance       Float                  @default(0)
  paymentStatus PaymentStatus          @default(unpaid)
  dueDate       DateTime?
  notes         String?
  items         SupplierPurchaseItem[]
  payments      SupplierPayment[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  User          User                   @relation(fields: [userId], references: [id])

  @@index([tenantId, branchId])
  @@map("supplier_purchases")
}

// Supplier Purchase Items
model SupplierPurchaseItem {
  id         String           @id @default(cuid())
  purchaseId String
  purchase   SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id])
  quantity   Int
  cost       Float
  total      Float
  createdAt  DateTime         @default(now())

  @@map("supplier_purchase_items")
}

// Supplier Payments
model SupplierPayment {
  id             String            @id @default(cuid())
  tenantId       String
  branchId       String?
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierId     String
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  purchaseId     String?
  purchase       SupplierPurchase? @relation(fields: [purchaseId], references: [id])
  amount         Float
  paymentMethod  String
  mobileProvider String?
  phoneNumber    String?
  transactionId  String?
  reference      String?
  notes          String?
  createdAt      DateTime          @default(now())

  @@index([tenantId, branchId])
  @@map("supplier_payments")
}

// =====================================================
// EXPENSES
// =====================================================

model Expense {
  id             String       @id @default(cuid())
  tenantId       String
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category       String // rent, transport, salaries, utilities, etc.
  description    String
  amount         Float
  paymentMethod  String
  cashAccountId  String? // Which cash account this expense was paid from
  cashAccount    CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  mobileProvider String?
  phoneNumber    String?
  transactionId  String?
  reference      String?
  notes          String?
  userId         String // Who recorded it
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Tenant         Tenant       @relation(fields: [tenantId], references: [id])
  User           User         @relation(fields: [userId], references: [id])

  @@index([tenantId, branchId])
  @@map("expenses")
}

// =====================================================
// CASH FLOW & ACCOUNTS
// =====================================================

model CashAccount {
  id              String            @id @default(cuid())
  tenantId        String
  name            String // "Cash Box", "MTN Mobile Money", "Stanbic Bank"
  type            String // cash, mobile_money, bank, card
  accountNumber   String? // Phone number for mobile money, account number for bank
  bankName        String? // Bank name (bank type only)
  accountHolder   String? // Name of the account holder
  branchName      String? // Bank branch (bank type only)
  balance         Float             @default(0)
  currency        String            @default("UGX")
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  Tenant          Tenant            @relation(fields: [tenantId], references: [id])
  CashTransaction CashTransaction[]
  Expense         Expense[]
  withdrawals     CustomerWithdrawal[]
  AssignedUsers   User[]            @relation("UserCashAccount")

  @@unique([tenantId, name])
  @@map("cash_accounts")
}

model CashTransaction {
  id           String      @id @default(cuid())
  tenantId     String
  accountId    String
  account      CashAccount @relation(fields: [accountId], references: [id])
  type         String // income, expense, transfer
  amount       Float
  balanceAfter Float
  reference    String? // Sale ID, Purchase ID, etc.
  description  String?
  userId       String
  createdAt    DateTime    @default(now())
  Tenant       Tenant      @relation(fields: [tenantId], references: [id])
  User         User        @relation(fields: [userId], references: [id])

  @@map("cash_transactions")
}

// =====================================================
// FEATURE ACCESS CONTROL
// =====================================================

// System Features
model Feature {
  id          String   @id @default(cuid())
  name        String   @unique // "inventory.products", "sales.returns", "reports.sales", etc.
  displayName String
  description String?
  module      String   @default("core") // "sales", "inventory", "customers", "suppliers", etc.
  category    String // "core", "advanced", "integration", "module"
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  planFeatures   PlanFeature[]
  tenantFeatures TenantFeature[]

  @@map("features")
}

// Plan Features (which features each plan includes)
model PlanFeature {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature  @relation(fields: [featureId], references: [id])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([planId, featureId])
  @@map("plan_features")
}

// Tenant Feature Overrides (manual overrides per tenant)
model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String
  featureId String
  feature   Feature  @relation(fields: [featureId], references: [id])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureId])
  @@map("tenant_features")
}

// Usage Limits per Tenant
model UsageLimit {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  maxProducts  Int      @default(100)
  maxUsers     Int      @default(5)
  maxBranches  Int      @default(1)
  maxCustomers Int      @default(100)
  maxSuppliers Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Tenant       Tenant[]

  @@map("usage_limits")
}

// =====================================================
// UPDATE EXISTING MODELS
// =====================================================

// Update Product to include new relations
// Update Sale to use SaleRecord instead
// Update Purchase to use SupplierPurchase instead

// =====================================================
// RENTALS - Hire / Rental System
// =====================================================

model Rental {
  id                 String       @id @default(cuid())
  rentalNo           String // e.g. HIRE-1234567890
  tenantId           String
  branchId           String?
  branch             Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?    @relation(fields: [customerId], references: [id])
  userId             String
  User               User         @relation(fields: [userId], references: [id])
  hireDate           DateTime     @default(now()) // When items go out
  expectedReturnDate DateTime // When items should come back
  actualReturnDate   DateTime? // When items actually returned
  totalAmount        Float        @default(0) // Total hire charge
  depositAmount      Float        @default(0) // Security deposit collected
  depositStatus      String       @default("collected") // collected, refunded, forfeited
  amountPaid         Float        @default(0) // Hire charge paid so far
  balance            Float        @default(0) // Outstanding hire charge
  paymentStatus      String       @default("unpaid") // paid, partial, unpaid
  paymentMethod      String?      @default("cash")
  mobileProvider     String?
  phoneNumber        String?
  transactionId      String?
  discount           Float        @default(0)
  taxRate            Float        @default(0)
  taxAmount          Float        @default(0)
  guarantorName      String?
  guarantorPhone     String?
  customerNin        String?
  status             RentalStatus @default(active)
  notes              String?
  items              RentalItem[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  Tenant             Tenant       @relation(fields: [tenantId], references: [id])

  @@index([tenantId, branchId])
  @@index([customerId])
  @@map("rentals")
}

model RentalItem {
  id              String         @id @default(cuid())
  rentalId        String
  rental          Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  quantity        Int            @default(1)
  unitHirePrice   Float          @default(0) // Price per period
  rentalPeriod    RentalPeriod   @default(daily)
  periods         Int            @default(1) // Number of periods (e.g. 3 days)
  totalAmount     Float          @default(0) // quantity * unitHirePrice * periods
  conditionOut    ItemCondition  @default(good) // Condition when hired out
  conditionReturn ItemCondition? // Condition when returned (null if not yet returned)
  damageFee       Float? // Fee charged if item returned damaged
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([rentalId])
  @@index([productId])
  @@map("rental_items")
}

// =====================================================
// SALE RETURNS & REFUNDS
// =====================================================

model SaleReturn {
  id           String           @id @default(cuid())
  returnNo     String
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  saleId       String?
  sale         Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id])
  total        Float            @default(0)
  reason       String?
  refundMethod String           @default("cash") // cash, credit, mobile_money
  status       String           @default("completed") // completed, pending
  items        SaleReturnItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tenantId, returnNo])
  @@index([tenantId, branchId])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id        String     @id @default(cuid())
  returnId  String
  return    SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  total     Float
  reason    String?
  createdAt DateTime   @default(now())

  @@index([returnId])
  @@map("sale_return_items")
}

// =====================================================
// ACCOUNTING
// =====================================================

model Account {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String // e.g. "1000", "2001"
  name         String // e.g. "Cash", "Accounts Receivable"
  type         String // asset, liability, equity, revenue, expense
  subType      String? // current_asset, fixed_asset, current_liability, etc.
  parentId     String?
  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  balance      Float         @default(0)
  isActive     Boolean       @default(true)
  description  String?
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  journalLines JournalLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(cuid())
  entryNo     String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  date        DateTime @default(now())
  description String?
  reference   String? // e.g. sale receipt no, invoice no
  status      String   @default("posted") // draft, posted, reversed
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  // Source tracking for idempotency (prevents double-posting)
  sourceType String? // SALARY_ADVANCE, PAYROLL, PAYROLL_PAYMENT, SALARY_ADVANCE_RECOVERY, etc.
  sourceId   String? // ID of the HR record or other source

  // Reversal tracking
  reversalOfId      String? // Reference to original entry if this is a reversal
  reversalJournalId String? // Back-reference to reversal entry
  reversalReason    String?
  reversedBy        String?
  reversedAt        DateTime?

  lines           JournalLine[]
  salaryAdvances  SalaryAdvance[]
  payrolls        Payroll[]
  payrollPayments PayrollPayment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, entryNo])
  @@unique([sourceType, sourceId]) // Ensure only one journal per source
  @@index([tenantId])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debit       Float        @default(0)
  credit      Float        @default(0)
  description String?
  createdAt   DateTime     @default(now())

  @@index([entryId])
  @@map("journal_lines")
}

// =====================================================
// HR MANAGEMENT
// =====================================================

model Employee {
  // =====================
  // BASIC IDENTIFICATION
  // =====================
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // =====================
  // PERSONAL INFORMATION
  // =====================
  firstName     String
  middleName    String? // Phase 1: New
  lastName      String
  employeeNumber String?
  profilePhoto   String?
  email         String?
  phone         String?
  gender        String? // male, female, other (Phase 1: New)
  dateOfBirth   DateTime? // (Phase 1: New)
  nationality   String? // (Phase 1: New)
  maritalStatus String? // single, married, divorced, widowed (Phase 1: New)
  bloodType     String? // A, B, O, AB (Phase 1: New)

  // =====================
  // IDENTIFICATION DOCUMENTS
  // =====================
  nationalId            String? // Passport, ID number (Phase 1: New)
  nationalIdType        String? // passport, national_id, drivers_license (Phase 1: New)
  taxId                 String? // Tax identification number (Phase 1: New)
  socialSecurityNumber String?

  // =====================
  // ADDRESS & CONTACT
  // =====================
  address    String?
  city       String? // (Phase 1: New)
  state      String? // (Phase 1: New)
  postalCode String? // (Phase 1: New)

  // =====================
  // EMERGENCY CONTACT (Phase 1: New)
  // =====================
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  nextOfKinName                 String?
  nextOfKinPhone                String?
  nextOfKinRelationship         String?

  // =====================
  // BANK ACCOUNT (Phase 1: New)
  // =====================
  bankName          String?
  bankAccountNumber String?
  bankAccountType   String? // savings, checking, etc
  bankSortCode      String?
  bankSwiftCode     String?

  // =====================
  // ORGANIZATIONAL STRUCTURE (Phase 1: New Relations)
  // =====================
  departmentId String? // References Department model
  department   Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)

  positionId   String? // References Position model
  positionRole Position? @relation("EmployeePositions", fields: [positionId], references: [id], onDelete: SetNull)

  supervisorId String? // Self-reference for supervisor
  supervisor   Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeSupervisor")

  teamId String? // References Team model
  team   Team?   @relation("TeamEmployees", fields: [teamId], references: [id], onDelete: SetNull)

  unitId String? // References Unit model
  unit   Unit?   @relation("UnitEmployees", fields: [unitId], references: [id], onDelete: SetNull)

  // =====================
  // EMPLOYMENT DETAILS
  // =====================
  position             String? // e.g. "Cashier", "Manager" (legacy field, use positionId)
  department_text      String? // (legacy field, use departmentId)
  jobTitle             String?
  basicSalary          Float     @default(0) // Base monthly salary
  payFrequency         String    @default("monthly") // weekly, biweekly, monthly
  employmentType       String    @default("permanent") // permanent, contract, temporary, casual, part-time, intern, consultant
  workLocation         String?
  costCentre           String?
  probationStartDate   DateTime?
  probationEndDate     DateTime?
  contractStartDate    DateTime?
  contractEndDate      DateTime?
  hireDate             DateTime  @default(now())
  terminationDate      DateTime?
  status               String    @default("active") // active, terminated, on_leave, suspended, on_probation
  salaryAdvanceBalance Float     @default(0) // Total outstanding salary advances
  salaryPayableBalance Float     @default(0) // Total outstanding salary payable
  openingSalaryAdvanceBalance Float @default(0) // Advance/loan owed back to the business before onboarding
  openingSalaryPayableBalance Float @default(0) // Salary already owed before onboarding
  openingHrBalanceDate DateTime?
  openingHrBalanceNote String?

  // =====================
  // TIMESTAMPS
  // =====================
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // =====================
  // RELATIONS
  // =====================
  attendance         Attendance[]
  leaveRequests      LeaveRequest[]
  payrollRecords     Payroll[]
  salaryConfig       EmployeeSalaryConfig?
  salaryAdvances     SalaryAdvance[]
  payrollAdjustments PayrollAdjustment[]
  payrollDeductions  PayrollDeduction[]
  auditLogs          HRAuditLog[]

  // Phase 1: HR Core Relations
  employeeContracts   EmployeeContract[]  @relation("EmployeeContracts")
  employeeDocuments   EmployeeDocument[]  @relation("EmployeeDocuments")
  salaryHistories     SalaryHistory[]     @relation("EmployeeSalaryHistory")
  employmentHistories EmploymentHistory[] @relation("EmployeeEmploymentHistory")

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, employeeNumber])
  @@index([departmentId])
  @@index([positionId])
  @@index([supervisorId])
  @@index([teamId])
  @@index([unitId])
  @@map("employees")
}

// =====================================================
// HR SALARY CONFIGURATION
// =====================================================

model EmployeeSalaryConfig {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String   @unique
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary        Float    @default(0)
  transportAllowance Float    @default(0)
  houseAllowance     Float    @default(0)
  mobileAllowance    Float    @default(0)
  otherAllowances    Float    @default(0)
  totalAllowances    Float    @default(0)
  grossSalary        Float    @default(0) // basicSalary + totalAllowances

  // Deductions
  paye              Float @default(0) // Pay as you earn tax
  socialSecurityTax Float @default(0)
  healthInsurance   Float @default(0)
  otherDeductions   Float @default(0)
  totalDeductions   Float @default(0)

  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, employeeId])
  @@map("employee_salary_configs")
}

// =====================================================
// SALARY ADVANCES
// =====================================================

model SalaryAdvance {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  advanceNo        String // e.g., ADV-001-2025
  amount           Float
  paymentAccountId String? // Cash/Bank account used for payment; null for opening balances
  date             DateTime @default(now())
  reason           String?
  isOpeningBalance Boolean  @default(false)

  // Recovery tracking
  totalRecovered    Float   @default(0)
  outstandingAmount Float // amount - totalRecovered
  recoveryMethod    String  @default("payroll") // payroll, direct_repayment, manual
  recoveryPlan      String? // e.g., "Fixed Amount", "5 Installments", "Full Next Payroll"
  recoveryAmount    Float   @default(0) // Expected recovery per period

  status       String    @default("outstanding") // outstanding, partially_recovered, fully_recovered, cancelled
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  // Accounting
  journalEntryId String? // Reference to accounting journal entry
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  // Audit
  approvedBy String?
  approvedAt DateTime?
  paidBy     String?
  paidAt     DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  recoveries SalaryAdvanceRecovery[]

  @@unique([tenantId, advanceNo])
  @@index([tenantId, employeeId])
  @@index([status])
  @@map("salary_advances")
}

model SalaryAdvanceRecovery {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salaryAdvanceId String
  salaryAdvance   SalaryAdvance @relation(fields: [salaryAdvanceId], references: [id], onDelete: Cascade)
  payrollId       String? // If recovered through payroll
  payroll         Payroll?      @relation(fields: [payrollId], references: [id], onDelete: SetNull)

  recoveryType String // payroll, direct_repayment, adjustment
  recoveryDate DateTime @default(now())
  amount       Float
  notes        String?
  createdAt    DateTime @default(now())

  @@index([tenantId, salaryAdvanceId])
  @@map("salary_advance_recoveries")
}

// =====================================================
// PAYROLL PROCESSING
// =====================================================

model Payroll {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payrollNo String // e.g., PAYROLL-001-JAN-2025
  period    String // e.g., "2025-01" (YYYY-MM)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Earnings
  basicSalary   Float @default(0)
  allowances    Float @default(0)
  bonus         Float @default(0)
  overtime      Float @default(0)
  otherEarnings Float @default(0)
  grossSalary   Float @default(0)

  // Deductions
  paye                  Float @default(0)
  socialSecurityTax     Float @default(0)
  healthInsurance       Float @default(0)
  otherDeductions       Float @default(0)
  salaryAdvanceRecovery Float @default(0)
  totalDeductions       Float @default(0)

  netSalary Float @default(0) // grossSalary - totalDeductions

  status String @default("draft") // draft, approved, posted, partially_paid, paid, reversed

  // Approvals & Posting
  approvedBy     String?
  approvedAt     DateTime?
  postedBy       String?
  postedAt       DateTime?
  journalEntryId String? // Accounting journal entry
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  // Payment
  paidAmount       Float     @default(0)
  paymentAccountId String? // Cash/Bank account for salary payment
  paymentDate      DateTime?
  paymentReference String?

  notes     String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjustments PayrollAdjustment[]
  deductions  PayrollDeduction[]
  recoveries  SalaryAdvanceRecovery[]
  payments    PayrollPayment[]

  @@unique([tenantId, payrollNo])
  @@unique([employeeId, period]) // One payroll per employee per period
  @@index([tenantId, period])
  @@index([status])
  @@map("payroll")
}

model PayrollAdjustment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollId  String
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        String // bonus, overtime, adjustment, other_earning
  description String
  amount      Float
  createdAt   DateTime @default(now())

  @@index([tenantId, payrollId])
  @@map("payroll_adjustments")
}

model PayrollDeduction {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollId  String
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        String // paye, social_security, health_insurance, loan, other
  description String
  amount      Float
  createdAt   DateTime @default(now())

  @@index([tenantId, payrollId])
  @@map("payroll_deductions")
}

model PayrollPayment {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollId String
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  amount           Float
  paymentMethod    String // cash, bank, mobile_money, cheque
  paymentAccountId String
  paymentDate      DateTime @default(now())
  referenceNo      String?
  status           String   @default("completed") // pending, completed, failed

  // Accounting
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdBy String
  createdAt DateTime @default(now())

  @@index([tenantId, payrollId])
  @@map("payroll_payments")
}

// =====================================================
// HR ACCOUNTING CONFIGURATION
// =====================================================

model HRAccountingConfig {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Required accounts
  salaryExpenseAccountId String? // Expense account for salary recognition
  salaryPayableAccountId String? // Liability account for salary payable
  salaryAdvanceAccountId String? // Asset account for salary advances given to employees

  // Deduction accounts
  payeTaxAccountId        String? // Liability for PAYE tax
  socialSecurityAccountId String? // Liability for social security

  isConfigured Boolean   @default(false)
  configuredBy String?
  configuredAt DateTime?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("hr_accounting_configs")
}

// =====================================================
// HR AUDIT LOG
// =====================================================

model HRAuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  recordType String // salary_advance, payroll, salary_advance_recovery, salary_advance_direct_repayment
  recordId   String // ID of the HR record (advance ID, payroll ID, etc.)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  action      String // created, approved, posted, paid, reversed, recovered, cancelled
  description String?
  amount      Float?

  userId   String // Who performed the action
  branchId String?

  journalEntryId String? // Reference to accounting entry

  metadata Json? // Additional context

  createdAt DateTime @default(now())

  @@index([tenantId, recordType, recordId])
  @@index([employeeId])
  @@index([createdAt])
  @@map("hr_audit_logs")
}

model Attendance {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime  @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("present") // present, absent, late, half_day, holiday
  notes      String?
  createdAt  DateTime  @default(now())

  @@unique([employeeId, date])
  @@index([tenantId, employeeId])
  @@map("attendance")
}

model LeaveRequest {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId          String
  leaveTypeName        String // Denormalized
  startDate            DateTime
  endDate              DateTime
  totalDays            Float // Calculated
  reason               String
  contactDuringLeave   String?
  replacementEmployeeId String?
  attachments          String[] // File URLs

  // Level 1 Approval
  approverLevel1Id     String?
  approverLevel1Status String? // approved, rejected, pending
  approverLevel1Date   DateTime?
  approverLevel1Notes  String?

  // Level 2 Approval
  approverLevel2Id     String?
  approverLevel2Status String? // approved, rejected, pending
  approverLevel2Date   DateTime?
  approverLevel2Notes  String?

  status               String   @default("draft") // draft, pending_l1, pending_l2, approved, rejected, on_leave, completed, cancelled
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId, employeeId])
  @@index([startDate, endDate])
  @@index([status])
  @@map("leave_requests")
}

// =====================================================
// STOCK TRANSFERS (Branch Transfers)
// =====================================================

model StockTransfer {
  id           String              @id @default(cuid())
  transferNo   String
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranchId String?
  fromBranch   Branch?             @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranchId   String?
  toBranch     Branch?             @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: SetNull)
  status       String              @default("pending") // pending, in_transit, received, cancelled
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  notes        String?
  items        StockTransferItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, transferNo])
  @@index([tenantId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([transferId])
  @@map("stock_transfer_items")
}

// =====================================================
// NOTIFICATIONS (Communication)
// =====================================================

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   @default("in_app") // in_app, sms, email, whatsapp
  title     String
  message   String
  type      String   @default("info") // info, warning, success, error
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, userId])
  @@map("notifications")
}

// =====================================================
// INTEGRATION CONFIG
// =====================================================

model IntegrationConfig {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider    String // stripe, flutterwave, mobile_money, qr_payments
  displayName String
  isActive    Boolean   @default(false)
  credentials Json? // encrypted credentials
  settings    Json? // provider-specific settings
  webhookUrl  String?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("integration_configs")
}

// =====================================================
// RESTAURANT MODULE
// =====================================================

// Restaurant Tables
model RestaurantTable {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name       String // "Table 1", "VIP 1", "Garden 3"
  capacity   Int         @default(4)
  status     TableStatus @default(available)
  area       String? // "Main Hall", "Terrace", "Garden", "Bar"
  mergedWith String? // ID of table this is merged into
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  orders       RestaurantOrder[]
  reservations Reservation[]

  @@index([tenantId, branchId])
  @@map("restaurant_tables")
}

enum TableStatus {
  available
  occupied
  reserved
  cleaning
}

// Restaurant Orders (Dine-in, Takeaway, Delivery)
model RestaurantOrder {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderNo             String // "ORD-001"
  tableId             String?
  table               RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiterId            String?
  waiter              Waiter?          @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  userId              String // who created the order (cashier/waiter)
  user                User             @relation(fields: [userId], references: [id])
  customerId          String?
  customer            Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderType           OrderType        @default(dine_in)
  status              OrderStatus      @default(pending)
  subtotal            Float            @default(0)
  tax                 Float            @default(0)
  discount            Float            @default(0)
  tipAmount           Float            @default(0)
  total               Float            @default(0)
  specialInstructions String?
  paymentStatus       PaymentStatus    @default(unpaid)
  paymentMethod       String?
  saleId              String? // linked Sale when completed
  deliveryId          String?          @unique // linked Delivery if delivery order
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  items    RestaurantOrderItem[]
  tips     Tip[]
  delivery Delivery?

  @@unique([tenantId, orderNo])
  @@index([tenantId, branchId, status])
  @@map("restaurant_orders")
}

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum OrderStatus {
  pending
  preparing
  ready
  served
  completed
  cancelled
}

// Order Items
model RestaurantOrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  quantity            Int             @default(1)
  price               Float           @default(0)
  discount            Float           @default(0)
  total               Float           @default(0)
  station             String? // "kitchen" or "bar" — determines KOT vs BOT
  status              ItemStatus      @default(pending)
  specialInstructions String?
  createdAt           DateTime        @default(now())

  @@index([orderId])
  @@map("restaurant_order_items")
}

enum ItemStatus {
  pending
  preparing
  ready
  served
  cancelled
}

// Waiters
model Waiter {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  name      String
  phone     String?
  code      String? // short code for quick assignment
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders RestaurantOrder[]
  tips   Tip[]

  @@index([tenantId])
  @@map("waiters")
}

// Tips
model Tip {
  id        String          @id @default(cuid())
  tenantId  String
  orderId   String
  order     RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waiterId  String?
  waiter    Waiter?         @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  userId    String // who recorded the tip
  user      User            @relation(fields: [userId], references: [id])
  amount    Float           @default(0)
  tipType   String          @default("amount") // "amount" or "percentage"
  tipValue  Float? // percentage value if tipType is percentage
  createdAt DateTime        @default(now())

  @@index([tenantId, orderId])
  @@map("tips")
}

// Reservations
model Reservation {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tableId         String?
  table           RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String?
  date            DateTime
  time            String // "19:30"
  guests          Int               @default(1)
  specialRequests String?
  status          ReservationStatus @default(reserved)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId, date])
  @@map("reservations")
}

enum ReservationStatus {
  reserved
  checked_in
  cancelled
  completed
}

// Recipes (Bill of Materials)
model Recipe {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String // the menu item this recipe is for
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  yield     String? // "1 plate", "2 servings"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients      RecipeIngredient[]
  productionOrders ProductionOrder[]

  @@unique([tenantId, productId])
  @@map("recipes")
}

model RecipeIngredient {
  id        String  @id @default(cuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String // the ingredient (inventory item)
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float   @default(0)
  unit      String  @default("Piece") // KG, ML, G, Piece, etc.
  notes     String?

  @@index([recipeId])
  @@map("recipe_ingredients")
}

// Happy Hour Pricing
model HappyHourRule {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  name          String // "Happy Hour", "Early Bird"
  productId     String? // null = applies to all, specific product = single item
  startTime     String // "16:00"
  endTime       String // "19:00"
  daysOfWeek    String? // "1,2,3,4,5" (Mon-Fri), null = every day
  discountType  String   @default("percentage") // "percentage" or "fixed"
  discountValue Float    @default(0) // 25 = 25% off, or 1500 = UGX 1500 off
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@map("happy_hour_rules")
}

// Combo Meals
model ComboMeal {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  name        String // "Lunch Combo"
  description String?
  price       Float    @default(0) // combo selling price
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ComboMealItem[]

  @@index([tenantId])
  @@map("combo_meals")
}

model ComboMealItem {
  id          String    @id @default(cuid())
  comboMealId String
  comboMeal   ComboMeal @relation(fields: [comboMealId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int       @default(1)

  @@index([comboMealId])
  @@map("combo_meal_items")
}

// Delivery
model Delivery {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId       String?          @unique // linked restaurant order
  order         RestaurantOrder? @relation(fields: [orderId], references: [id])
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  address       String
  riderName     String?
  riderPhone    String?
  deliveryFee   Float            @default(0)
  status        DeliveryStatus   @default(pending)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId, status])
  @@map("deliveries")
}

enum DeliveryStatus {
  pending
  on_delivery
  delivered
  cancelled
}

// =====================
// REFERRAL SYSTEM
// =====================

model ReferralCode {
  id        String     @id @default(cuid())
  code      String     @unique
  tenantId  String     @unique
  tenant    Tenant     @relation("ReferralCodeTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  referrals Referral[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("referral_codes")
}

model Referral {
  id               String               @id @default(cuid())
  referralCodeId   String
  referralCode     ReferralCode         @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referrerTenantId String
  referrerTenant   Tenant               @relation("ReferrerTenant", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referredTenantId String?              @unique
  referredTenant   Tenant?              @relation("ReferredTenant", fields: [referredTenantId], references: [id], onDelete: SetNull)
  referredEmail    String
  status           ReferralStatus       @default(pending)
  rewardType       ReferralRewardType   @default(subscription_discount)
  rewardValue      Float                @default(10) // percentage or months
  rewardStatus     ReferralRewardStatus @default(unclaimed)
  appliedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  reward           ReferralReward?

  @@index([referrerTenantId])
  @@index([status])
  @@map("referrals")
}

model ReferralReward {
  id          String             @id @default(cuid())
  referralId  String             @unique
  referral    Referral           @relation(fields: [referralId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant             @relation("ReferralRewardTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  type        ReferralRewardType @default(subscription_discount)
  value       Float
  description String?
  claimedAt   DateTime           @default(now())

  @@map("referral_rewards")
}

enum ReferralStatus {
  pending
  invited
  signed_up
  subscribed
  completed
  expired
  cancelled
}

enum ReferralRewardType {
  subscription_discount
  free_months
  credit
  feature_unlock
}

enum ReferralRewardStatus {
  unclaimed
  claimed
  expired
}

// =====================================================
// FUEL STATION MODULE
// =====================================================

model FuelPump {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String // "Pump 1", "Pump 2"
  tankId      String?
  tank        FuelTank? @relation(fields: [tankId], references: [id], onDelete: SetNull)
  nozzleCount Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  meterReadings FuelMeterReading[]
  shiftReports  FuelShiftReport[]

  @@index([tenantId, branchId])
  @@map("fuel_pumps")
}

model FuelTank {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name         String // "Tank 1 - Petrol", "Tank 2 - Diesel"
  fuelType     String // petrol, diesel, kerosene, gas
  capacity     Float    @default(0) // litres
  currentStock Float    @default(0) // litres
  unitCost     Float    @default(0) // cost per litre
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pumps            FuelPump[]
  deliveries       FuelDelivery[]
  dipstickReadings FuelDipstickReading[]

  @@index([tenantId, branchId])
  @@map("fuel_tanks")
}

model FuelDelivery {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tankId       String
  tank         FuelTank @relation(fields: [tankId], references: [id])
  supplierName String?
  invoiceNo    String?
  litres       Float
  unitCost     Float
  totalCost    Float
  deliveryDate DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  @@index([tenantId, branchId])
  @@map("fuel_deliveries")
}

model FuelMeterReading {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pumpId         String
  pump           FuelPump @relation(fields: [pumpId], references: [id])
  shiftId        String?
  openingReading Float    @default(0) // litres at start
  closingReading Float    @default(0) // litres at end
  litresSold     Float    @default(0)
  amount         Float    @default(0)
  readingDate    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([tenantId, pumpId])
  @@map("fuel_meter_readings")
}

model FuelShiftReport {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shiftNo        String
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  pumpId         String?
  pump           FuelPump? @relation(fields: [pumpId], references: [id])
  openingReading Float     @default(0)
  closingReading Float     @default(0)
  litresSold     Float     @default(0)
  cashSales      Float     @default(0)
  mobileSales    Float     @default(0)
  creditSales    Float     @default(0)
  totalSales     Float     @default(0)
  lubricantSales Float     @default(0)
  carWashIncome  Float     @default(0)
  expenses       Float     @default(0)
  netAmount      Float     @default(0)
  startDate      DateTime
  endDate        DateTime?
  status         String    @default("open") // open, closed, reconciled
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, shiftNo])
  @@index([tenantId, branchId])
  @@map("fuel_shift_reports")
}

model FuelDipstickReading {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tankId        String
  tank          FuelTank @relation(fields: [tankId], references: [id])
  readingDate   DateTime @default(now())
  dipstickLevel Float    @default(0) // physical litres measured by dipstick
  bookStock     Float    @default(0) // system book stock at time of reading
  variance      Float    @default(0) // dipstickLevel - bookStock
  attendant     String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([tenantId, tankId])
  @@map("fuel_dipstick_readings")
}

model FuelPricing {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fuelType      String // petrol, diesel, kerosene, gas
  pumpPrice     Float    @default(0) // selling price per litre
  costPrice     Float    @default(0) // cost per litre
  margin        Float    @default(0) // pumpPrice - costPrice
  effectiveDate DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  @@index([tenantId, fuelType])
  @@map("fuel_pricing")
}

model FuelCompliance {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  inspectionDate DateTime  @default(now())
  type           String // e.g. environmental, safety, calibration
  result         String // pass, fail, pending
  nextDue        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([tenantId, branchId])
  @@map("fuel_compliance")
}

// =====================================================
// MANUFACTURING MODULE
// =====================================================

model ProductionOrder {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderNo          String
  productId        String // the finished good to produce
  product          Product   @relation(fields: [productId], references: [id])
  recipeId         String? // linked BOM/Recipe
  recipe           Recipe?   @relation(fields: [recipeId], references: [id])
  quantity         Float     @default(0) // units to produce (planned)
  actualQuantity   Float     @default(0) // actual units produced
  unitCost         Float     @default(0) // material cost per unit
  laborCost        Float     @default(0) // labor cost total
  overheadCost     Float     @default(0) // overhead cost total
  standardCost     Float     @default(0) // expected total cost (BOM-based)
  actualCost       Float     @default(0) // actual total cost (material + labor + overhead + waste)
  totalCost        Float     @default(0) // legacy field — kept for backward compat
  wasteQty         Float     @default(0)
  expectedYield    Float     @default(0) // expected output quantity
  actualYield      Float     @default(0) // actual output quantity
  batchNumber      String? // production batch/lot number
  qualityStatus    String    @default("pending") // pending, passed, failed, rework
  qualityNotes     String?
  qualityCheckedBy String?
  qualityCheckedAt DateTime?
  status           String    @default("pending") // pending, in_progress, completed, cancelled
  startDate        DateTime?
  endDate          DateTime?
  plannedStartDate DateTime? // scheduled start
  plannedEndDate   DateTime? // scheduled end
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wasteRecords  ProductionWaste[]
  qualityChecks QualityCheck[]
  batches       ProductionBatch[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, qualityStatus])
  @@map("production_orders")
}

model ProductionWaste {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productId         String? // wasted ingredient (if applicable)
  product           Product?        @relation(fields: [productId], references: [id])
  quantity          Float           @default(0)
  unitCost          Float           @default(0)
  totalCost         Float           @default(0)
  reason            String?
  createdAt         DateTime        @default(now())

  @@index([tenantId, productionOrderId])
  @@map("production_waste")
}

model QualityCheck {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkType         String // incoming_material, in_process, final_inspection
  status            String          @default("pending") // pending, passed, failed, rework
  checkedBy         String?
  checkedAt         DateTime?
  notes             String?
  defectQty         Float           @default(0)
  defectDescription String?
  createdAt         DateTime        @default(now())

  @@index([tenantId, productionOrderId])
  @@index([tenantId, status])
  @@map("quality_checks")
}

model ProductionBatch {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id])
  batchNumber       String
  quantity          Float           @default(0)
  manufacturedDate  DateTime        @default(now())
  expiryDate        DateTime?
  status            String          @default("active") // active, quarantined, recalled, expired
  notes             String?
  createdAt         DateTime        @default(now())

  @@unique([tenantId, batchNumber])
  @@index([tenantId, productionOrderId])
  @@index([tenantId, status])
  @@map("production_batches")
}

// =====================================================
// AGRICULTURE MODULE
// =====================================================

model FarmField {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String // "North Field", "Paddock A"
  areaSize  Float    @default(0) // acres/hectares
  areaUnit  String   @default("acre") // acre, hectare
  cropType  String? // current crop
  status    String   @default("active") // active, fallow, harvested
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  harvests      Harvest[]
  fieldExpenses FarmExpense[]

  @@index([tenantId, branchId])
  @@map("farm_fields")
}

model Livestock {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String // "Cattle Herd", "Poultry House 1"
  type      String // cattle, poultry, goats, sheep, pigs, fish
  breed     String?
  count     Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  harvests Harvest[]
  expenses FarmExpense[]

  @@index([tenantId, branchId])
  @@map("livestock")
}

model Harvest {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fieldId     String?
  field       FarmField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  livestockId String?
  livestock   Livestock? @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  type        String // crop, milk, eggs, meat
  productName String? // e.g. "Maize", "Milk", "Eggs"
  productId   String? // linked inventory product (harvest increases stock)
  product     Product?   @relation(fields: [productId], references: [id])
  quantity    Float      @default(0)
  unit        String     @default("kg") // kg, litres, trays, bags
  quality     String? // grade A, grade B, etc.
  harvestDate DateTime   @default(now())
  notes       String?
  createdAt   DateTime   @default(now())

  @@index([tenantId, branchId])
  @@map("harvests")
}

model FarmExpense {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fieldId     String?
  field       FarmField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  livestockId String?
  livestock   Livestock? @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  category    String // seeds, fertilizer, feed, veterinary, labour, fuel, irrigation
  description String
  amount      Float
  date        DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([tenantId, branchId])
  @@map("farm_expenses")
}

// =====================================================
// SERVICE ENGINE (Appointments, Work Orders, Contracts)
// =====================================================

model Appointment {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  productId       String? // service item
  product         Product?  @relation(fields: [productId], references: [id])
  technicianId    String? // assigned user/staff
  technician      User?     @relation("AppointmentTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  scheduledDate   DateTime
  scheduledTime   String // "09:30"
  endTime         String? // "10:30"
  duration        String? // "1 hour", "30 min"
  status          String    @default("scheduled") // scheduled, confirmed, in_progress, completed, cancelled, no_show
  price           Float     @default(0)
  actualPrice     Float     @default(0) // final price after completion
  notes           String?
  reminderSent    Boolean   @default(false) // SMS/email reminder sent
  completedAt     DateTime?
  cancelledReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobCards ServiceJobCard[]
  feedback ServiceFeedback[]

  @@index([tenantId, scheduledDate])
  @@index([tenantId, technicianId])
  @@index([tenantId, status])
  @@map("appointments")
}

model WorkOrder {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderNo         String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  productId       String? // service item
  product         Product?  @relation(fields: [productId], references: [id])
  technicianId    String?
  technician      User?     @relation("WorkOrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          String    @default("open") // open, in_progress, on_hold, completed, cancelled
  priority        String    @default("normal") // low, normal, high, urgent
  serviceCategory String? // e.g., "repair", "installation", "maintenance", "consultation"
  estimatedCost   Float     @default(0)
  actualCost      Float     @default(0)
  laborCost       Float     @default(0)
  partsCost       Float     @default(0)
  startDate       DateTime?
  endDate         DateTime?
  diagnostics     String? // technician diagnosis notes
  warrantyInfo    String? // warranty details for the work done
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobCards ServiceJobCard[]
  feedback ServiceFeedback[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, branchId])
  @@index([tenantId, technicianId])
  @@index([tenantId, status])
  @@map("work_orders")
}

model ServiceContract {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contractNo      String
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  title           String
  description     String?
  serviceCategory String? // e.g., "maintenance", "consulting", "cleaning", "IT support"
  startDate       DateTime
  endDate         DateTime?
  renewalDate     DateTime? // auto-renewal date if applicable
  autoRenew       Boolean   @default(false)
  nextBillingDate DateTime? // upcoming billing date
  value           Float     @default(0)
  billingCycle    String    @default("monthly") // one_time, monthly, quarterly, yearly
  discountPercent Float     @default(0) // loyalty discount
  status          String    @default("active") // active, expired, terminated, cancelled, pending_renewal
  terms           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  feedback ServiceFeedback[]

  @@unique([tenantId, contractNo])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@map("service_contracts")
}

// Dedicated Car Wash records (optional, new)
model CarWashRecord {
